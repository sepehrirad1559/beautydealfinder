# Database (Railway/Render/Supabase Postgres, or local for dev)
DATABASE_URL=postgres://user:password@localhost:5432/beautydealfinder

# Amazon Product Advertising API (PA-API 5.0) — requires an Amazon
# Associates account that's driven qualifying sales; apply at
# https://affiliate-program.amazon.com/ then request PA-API access from
# https://webservices.amazon.com/paapi5/documentation/
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Admin dashboard (low-privilege — viewing stats only)
ADMIN_DASHBOARD_PASSWORD=

# Sync/rebuild trigger key (higher-privilege — writes data)
SYNC_SECRET_KEY=

# Salt used to hash IPs for click analytics (never store raw IPs)
CLICK_SALT=

PORT=30011
